{% if a.trends and a.trends.themes %}
<div style="background:#fff;border:1px solid #e3e6ec;border-radius:10px;padding:12px 14px;margin:12px 0;line-height:1.6;font-size:14px">
<b style="font-size:16px">🌍 מגמות בעולם שכדאי להכיר</b>
{% if a.trends.summary %}<div style="color:#5c6675;font-size:13px;margin:4px 0">{{ a.trends.summary }}</div>{% endif %}
{% for t in a.trends.themes %}
<div style="border-top:1px solid #eee;margin-top:8px;padding-top:6px"><b>{{ t.name }}</b> <span style="color:#5c6675;font-size:12px">· שלב: {{ t.stage }} · אופק: {{ t.horizon }} · <span dir="ltr">{{ t.etfs|join(', ') }}</span></span>
<div><b>מה זה?</b> {{ t.explain }}</div>
<div><b>למה עכשיו:</b> {{ t.why_now }}</div>
<div><b>איך לשחק:</b> {{ t.how_to_play }}</div>
<div style="font-size:13px">⚠ {{ t.risk }}</div>
{% for p in t.picks %}{% set x = cx.get(p.ticker) %}
<div style="margin:4px 12px;font-size:13px"><b dir="ltr">{{ p.ticker }}</b> {{ p.name }}{% if p.type == 'etf' %} (קרן סל){% endif %} <span dir="ltr">${{ '%.2f'|format(p.price) }}</span> – {{ p.thesis }}
<br><span style="color:#5c6675">ביטחון {{ p.conviction }}{% if p.buy_below %} · קנייה עד ${{ '%.2f'|format(p.buy_below) }}{% endif %}{% if p.target %} · יעד ${{ '%.2f'|format(p.target) }}{% endif %}{% if p.stop %} · סטופ ${{ '%.2f'|format(p.stop) }}{% endif %}</span>
{% if x %}<br><span style="color:#1d4ed8">{% if x.weight %}כבר בתיק: {{ '%.1f'|format(x.weight) }}%{% if x.avoid_add %} (<b>{{ x.reason }} – לא להוסיף</b>){% endif %} · {% endif %}{% if x.units %}המזומן שלך (${{ '%.0f'|format(x.cash) }}) מספיק לכ-{{ x.units }} יח׳ (גם חלקי יחידה){% else %}אין מזומן פנוי{% endif %}{% if x.per100 %} · כל $100 = כ-{{ x.per100 }} יח׳{% endif %}</span>{% endif %}</div>
{% endfor %}</div>
{% endfor %}
{% if a.trends.leaders %}<div style="margin-top:8px;font-size:13px;color:#5c6675"><b>מובילים בסריקה:</b> {% for r in a.trends.leaders %}{{ r.name }} ({{ '%+.0f'|format(r.rel3) }}%){% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
<div style="color:#8a94a6;font-size:12px;margin-top:6px">הסריקה אוטומטית; ה-AI מסביר ובוחר, ואינו ייעוץ השקעות.</div>
</div>
{% endif %}
