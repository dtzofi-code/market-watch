{% if pf and pa %}{% set t = pf.totals %}
<div style="background:#fff;border:2px solid #1d4ed8;border-radius:10px;padding:12px 14px;margin:14px 0;line-height:1.6;font-size:14px">
<b style="font-size:17px">💼 התיק שלי</b>
<div style="color:#5c6675;font-size:13px">{{ t.n }} ניירות {% if t.day_pct is not none %} · שינוי יומי משוער <span dir="ltr" style="color:{{ '#0f8a4b' if t.day_pct>=0 else '#c62828' }}">{{ '%+.2f'|format(t.day_pct) }}%</span>{% endif %}{% if t.pnl_pct is not none %} · רווח/הפסד כולל <span dir="ltr" style="color:{{ '#0f8a4b' if t.pnl_pct>=0 else '#c62828' }}">{{ '%+.1f'|format(t.pnl_pct) }}%</span>{% endif %} · מצב התיק: {{ pa.health }}</div>
<p style="margin:6px 0">{{ pa.summary }}</p>
{% if pa.goal %}{% set g = pa.goal %}<div style="background:#eefaf1;border-radius:8px;padding:8px 10px;margin:8px 0;font-size:13px"><b>🎯 יעד: {{ '{:,.0f}'.format(g.target_ils) }} ₪ עד סוף השנה</b>
<div>שווי נוכחי ≈ {{ '{:,.0f}'.format(g.current_ils) }} ₪ · פער ≈ {{ '{:,.0f}'.format(g.gap_ils) }} ₪ · נותרו {{ g.weeks_left }} שבועות</div>
<div>תשואה נדרשת: <b dir="ltr">{{ '%+.1f'|format(g.required_total_pct) }}%</b> (כ-<span dir="ltr">{{ g.required_weekly_pct }}%</span> בשבוע ברציפות){% if g.progress_pct is not none %} · התקדמות {{ g.progress_pct }}% מהדרך{% endif %}</div>
<div>ביחס לקו ישר אל היעד: <b style="color:{{ '#0f8a4b' if g.on_track else '#c62828' }}">{{ '%+.1f'|format(g.vs_path_pct) }}%</b> ({{ 'בקצב' if g.on_track else 'מאחורי הקצב' }})</div>
{% if pa.goal_assessment and pa.goal_assessment.verdict %}<div style="margin-top:4px"><b>הערכה:</b> {{ pa.goal_assessment.verdict }}</div>{% if pa.goal_assessment.what_must_go_right %}<div>מה צריך לקרות: {{ pa.goal_assessment.what_must_go_right }}</div>{% endif %}{% if pa.goal_assessment.alternatives %}<div>חלופות: {{ pa.goal_assessment.alternatives|join(' · ') }}</div>{% endif %}{% endif %}
<div style="color:#8a94a6;font-size:11px">ההתקדמות כוללת גם הפקדות/משיכות, שאינן מנוטרות.</div></div>{% endif %}
{% if pa.top_actions %}<div style="background:#eef3ff;border-radius:8px;padding:8px 10px;margin:8px 0"><b>פעולות מרכזיות</b>{% for x in pa.top_actions %}<div style="margin:4px 0">• {% if x.ticker %}<b dir="ltr">{{ x.ticker }}</b> – {% endif %}{{ x.text }}{% if x.action %} <b>[{{ x.action }}]</b>{% endif %}{% if x.size_text %}<br><span style="margin-inline-start:12px"><b>כמה: {{ x.size_text }}</b></span>{% endif %}{% if x.levels_text %}<br><span style="margin-inline-start:12px">💲 {{ x.levels_text }}</span>{% endif %}</div>{% endfor %}</div>{% endif %}
{% if pa.cash_summary or pa.cash_note %}<div style="background:#fff8e6;border-radius:8px;padding:8px 10px;margin:8px 0;font-size:13px"><b>תזרים מוצע</b>{% if pa.cash_note %}<div>{{ pa.cash_note }}</div>{% endif %}{% for lbl, txt in pa.cash_summary.items() %}<div>{{ lbl }}: {{ txt }}</div>{% endfor %}</div>{% endif %}
{% if pa.exposure_to_today %}<p style="margin:6px 0"><b>חשיפה לאירועי היום:</b> {{ pa.exposure_to_today }}</p>{% endif %}
{% if pa.concentration %}<p style="margin:6px 0"><b>ריכוזיות:</b> {{ pa.concentration }}</p>{% endif %}
<table style="width:100%;border-collapse:collapse;font-size:13px;margin-top:8px">
<tr style="color:#5c6675;text-align:right"><th>נייר</th><th>משקל</th><th>רו"ה</th><th>יום</th><th>קצר</th><th>בינוני</th><th>ארוך</th></tr>
{% set pos = {} %}{% for p in pa.positions %}{% if pos.update({p.ticker: p}) %}{% endif %}{% endfor %}
{% for r in pf.rows %}{% set p = pos.get(r.ticker) %}
<tr style="border-top:1px solid #eee;vertical-align:top"><td><b dir="ltr">{{ r.ticker }}</b><br><span style="color:#5c6675">{{ r.name }}</span></td>
<td dir="ltr">{% if r.weight is not none %}{{ '%.1f'|format(r.weight) }}%{% else %}–{% endif %}</td>
<td dir="ltr" style="color:{{ '#0f8a4b' if (r.pnl_pct or 0)>=0 else '#c62828' }}">{% if r.pnl_pct is not none %}{{ '%+.0f'|format(r.pnl_pct) }}%{% else %}–{% endif %}</td>
<td dir="ltr" style="color:{{ '#0f8a4b' if (r.m.get('d1') or 0)>=0 else '#c62828' }}">{% if r.m.get('d1') is not none %}{{ '%+.1f'|format(r.m.get('d1')) }}%{% else %}–{% endif %}</td>
{% for k in ['short','medium','long'] %}<td>{% if p and p.get(k) %}<b>{{ p[k].action }}</b>{% if p[k].size_text %}<br><span style="font-size:11px;color:#3b4452">{{ p[k].size_text }}</span>{% endif %}{% endif %}</td>{% endfor %}</tr>
{% if p %}<tr><td colspan="7" style="color:#3b4452;padding:0 0 6px;font-size:12px">{{ p.analysis }}{% if p.levels_text %}<br>💲 <b>{{ p.levels_text }}</b>{% if p.levels_note %} <span style="color:#8a94a6">({{ p.levels_note }})</span>{% endif %}{% endif %}{% for k, lbl in [('short','קצר'),('medium','בינוני'),('long','ארוך')] %}{% if p.get(k) and p[k].why %}<br>• <b>{{ lbl }}:</b> {{ p[k].why }}{% if p[k].size_text %} — <b>{{ p[k].size_text }}</b>{% endif %}{% endif %}{% endfor %}{% if p.watch %}<br>👁 {{ p.watch }}{% endif %}</td></tr>{% endif %}
{% endfor %}</table>
{% if pa.risks %}<div style="margin-top:8px"><b>סיכונים:</b> {{ pa.risks|join(' · ') }}</div>{% endif %}
{% if t.no_data %}<div style="color:#8a94a6;font-size:12px;margin-top:6px">{{ t.no_data }} ניירות ללא נתוני שוק (קרנות/תפ"ס) – הניתוח שלהם איכותי בלבד.</div>{% endif %}
<div style="color:#8a94a6;font-size:12px;margin-top:6px">ניתוח אוטומטי ואינו ייעוץ השקעות. הסכומים מחושבים לפי המחיר האחרון, ללא עמלות ומיסים וללא ידיעת יתרת המזומן שלך. ל-AI נשלחו רק אחוזים, לא כמויות או סכומים.{% if not t.sized %} לא הוגדרו כמויות ועלות, לכן אין משקלים ורווח/הפסד בתיק.{% endif %}</div>
</div>
{% endif %}
